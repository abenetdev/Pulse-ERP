{
    "compilerOptions": {
      "jsx": "react",
      "baseUrl": ".",
      "paths": {
        "@/components/*": ["src/components/*"]
      },
      "strict": true, // Enable strict type-checking
      "esModuleInterop": true, // For better compatibility with CommonJS modules
      "moduleResolution": "node", // Ensure proper module resolution
      "target": "ES6", // Specify the JavaScript version to compile to
      "outDir": "dist", // Output directory for compiled files
      "allowJs": true // Allow JavaScript files if needed
    },
    "include": ["src/**/*", "admin/**/*"],
    "exclude": ["node_modules", "dist"]
  }